@page "/logout"
@inherits LogoutPage
@layout HeadlessLayout



<PageTitle> MedMedicines - Sign Out </PageTitle>

<MudText Typo="Typo.h3"> Ending Session...</MudText>
<MudPaper Class="pa-8 mt-4">
    <MudAlert Severity="Severity.Info">
        <div>
            Session Ended...
            <MudButton Variant="Variant.Text" OnClick="GoToLogin">
                GO TO LOGIN SCREEN
            </MudButton>
        </div>
    </MudAlert>
</MudPaper>



