@page "/medicines/create"
@inherits CreatePage


<MudText Typo="Typo.h5">New Medicine</MudText>

<EditForm Model="this" OnValidSubmit="HandleCreate">
    <DataAnnotationsValidator/>

    <MudTextField Label="Name" @bind-Value="Name" Required="true" />

    <MudTimePicker Label="Time" @bind-Time="Time" />

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled">
        Save
    </MudButton>


</EditForm>
