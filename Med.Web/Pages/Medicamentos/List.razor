@page "/medicines"
@inherits ListPage

<MudText Typo="Typo.h4">Medicines</MudText>

@if (SelectedMedicine != null)
{
    <MudPaper Class="pa-4 mb-4" Style="background-color:#e3f2fd">
        <MudText Typo="Typo.h6">@SelectedMedicine.Name</MudText>
        <MudText>Time: @SelectedMedicine.Time</MudText>
    </MudPaper>
}

<MudTable Items="Medicines"
          T="Medicine"
          Hover="true"
          RowStyleFunc="@RowStyle"
          OnRowClick="@((args) => args.Item is null ? Task.CompletedTask : GoToMedicine(args.Item.Id))">

    <HeaderContent>
        <MudTh Style="width:25%">Name</MudTh>
        <MudTh Style="width:25%">Time</MudTh>
        <MudTh Style="width:25%">Taken</MudTh>
        <MudTh Style="width:25%">Actions</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Time">@context.Time</MudTd>
        <MudTd DataLabel="Taken">
            <MudButton Variant="Variant.Filled"
                       Color="@(context.Taken ? Color.Success : Color.Warning)"
                       OnClick="@(() => ToggleTaken(context))">

                @(context.Taken ? "Taken" : "Pending")

            </MudButton></MudTd>
        <MudTd DataLabel="Actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       OnClick="@(() => Delete(context.Id))">
                Delete
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>